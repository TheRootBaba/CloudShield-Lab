# Copy to .env.production on the deployment host. Never commit that file.
# Point DNS A/AAAA records at the deployment host before starting Caddy.
CLOUDSHIELD_DOMAIN=cloudshield.example.com
CLOUDSHIELD_TLS_EMAIL=ops@example.com

# Keep these exact values in production. Do not disable browser authentication.
CLOUDSHIELD_AUTH_MODE=multi_user
CLOUDSHIELD_AUTH_PROVIDER=firebase
# Public Firebase Web app settings (safe to expose to browsers).
CLOUDSHIELD_FIREBASE_PROJECT_ID=your-firebase-project-id
CLOUDSHIELD_FIREBASE_API_KEY=your-firebase-web-api-key
CLOUDSHIELD_FIREBASE_AUTH_DOMAIN=your-firebase-project.firebaseapp.com
CLOUDSHIELD_FIREBASE_APP_ID=your-firebase-web-app-id
CLOUDSHIELD_FIREBASE_MESSAGING_SENDER_ID=your-firebase-sender-id
# Host path to the Admin SDK JSON key; Compose mounts it read-only at /run/secrets/firebase-admin.json.
CLOUDSHIELD_FIREBASE_CREDENTIALS_FILE=/secure/path/firebase-admin.json
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Required to prevent an untrusted visitor claiming the first administrator account.
CLOUDSHIELD_BOOTSTRAP_TOKEN=
CLOUDSHIELD_COOKIE_SECURE=1
CLOUDSHIELD_HTTP_LOG=0

# Persistent in-container paths; Compose maps these to a protected named volume.
CLOUDSHIELD_AUTH_DB=/data/auth.sqlite3
CLOUDSHIELD_TENANT_DIR=/data/tenants
CLOUDSHIELD_DB=/data/legacy.sqlite3
CLOUDSHIELD_HOST=0.0.0.0
CLOUDSHIELD_PORT=8765
CLOUDSHIELD_CONTAINER_MODE=1

# Live cloud collectors stay disabled unless a separately approved validation is underway.
CLOUDSHIELD_ENABLE_AWS_COLLECTOR=0
CLOUDSHIELD_ENABLE_AWS_INVENTORY=0
CLOUDSHIELD_ENABLE_AZURE_COLLECTION=0

# Optional Firebase Identity Platform SAML/OIDC provider ID (e.g. oidc.company)
CLOUDSHIELD_FIREBASE_SSO_PROVIDER_ID=

# Bounded read-only provider polling interval (60?3600 seconds; default 300)
CLOUDSHIELD_COLLECTION_INTERVAL_SECONDS=300
